[submodule "crates/rust-url"]
	path = crates/rust-url
	url = https://github.com/servo/rust-url.git
[submodule "crates/nom"]
	path = crates/nom
	url = https://github.com/rust-bakery/nom.git
[submodule "crates/bat"]
	path = crates/bat
	url = https://github.com/sharkdp/bat.git
[submodule "crates/bitflags"]
	path = crates/bitflags
	url = https://github.com/bitflags/bitflags.git
[submodule "crates/clap"]
	path = crates/clap
	url = https://github.com/clap-rs/clap.git
[submodule "crates/grex"]
	path = crates/grex
	url = https://github.com/pemistahl/grex.git
[submodule "crates/image"]
	path = crates/image
	url = https://github.com/image-rs/image.git
[submodule "crates/RustPython"]
	path = crates/RustPython
	url = https://github.com/RustPython/RustPython.git
[submodule "perf/rustc-perf"]
	path = perf/rustc-perf
	url = https://github.com/sfu-rsl/rustc-perf
